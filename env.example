# Kopieren Sie diese Datei zu ".env" und tragen Sie Ihre Werte ein
# (lokal). Auf Render werden dieselben Variablen im Dashboard unter
# "Environment" gesetzt, keine .env-Datei nötig.

# Ihr eigener OpenAI-API-Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Optional: OpenAI-Modell (Standard: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: Systemprompt für den Chat
CHAT_SYSTEM_PROMPT=Du bist ein hilfreicher Assistent im Rahmen einer wissenschaftlichen Studie. Antworte klar, freundlich und auf Deutsch, sofern die Teilnehmerin oder der Teilnehmer nicht in einer anderen Sprache schreibt.

# Bedingung dieses Repositorys (Ordner bedingungen/treatment/).
# Optional: wird automatisch erkannt, weil nur dieser Ordner existiert.
BEDINGUNG=treatment

# Zeitlimit fuer den Chat in Minuten (0 = kein Limit). Standard: 10
CHAT_TIME_LIMIT_MINUTES=10

# Ab wann laeuft die Zeit?
#   first_message = ab der ersten Nachricht der Teilnehmenden (Standard)
#   session       = ab dem Laden der Chat-Seite
CHAT_TIMER_START=first_message

# Optional: fester Admin-Schlüssel für /admin.html und den CSV-Export.
# Wenn nicht gesetzt, wird automatisch einer erzeugt und in eine Datei
# geschrieben (auf Render ohne persistenten Disk geht dieser bei jedem
# Deploy verloren -> auf Render besser explizit setzen).
ADMIN_KEY=

# Optional: Pfad zur SQLite-Datenbankdatei. Auf Render mit persistentem
# Disk z. B. /data/data.db
DB_PATH=

# Von Render automatisch gesetzt, lokal Standard 8000
PORT=8000
